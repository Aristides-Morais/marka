generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  primaryColor   String   @default("#16a34a")
  phone          String?
  iban           String?
  expressNumber  String?
  bankName       String?
  feedbackPhone  String?
  storeBgColor   String?
  storeBgImage   String?
  bookingBgColor String?
  bookingBgImage String?
  address        String?
  openTime       String   @default("08:00")
  closeTime      String   @default("18:00")
  modules        String[] @default(["booking"])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  users          User[]
  services       Service[]
  products       Product[]
  reservations   Reservation[]
  orders         Order[]

  @@map("businesses")
}

model User {
  id            String   @id @default(cuid())
  email         String
  passwordHash  String
  name          String
  role          String   @default("ADMIN")
  businessId    String
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([email, businessId])
  @@map("users")
}

model Service {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  durationMin   Int      @default(30)
  price         Decimal  @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservations  Reservation[]

  @@index([businessId])
  @@map("services")
}

model Reservation {
  id            String   @id @default(cuid())
  businessId    String
  serviceId     String
  clientName    String
  clientPhone   String
  startTime     DateTime
  endTime       DateTime
  status        String   @default("CONFIRMED")
  notes         String?
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service       Service  @relation(fields: [serviceId], references: [id])

  @@index([businessId, startTime])
  @@index([businessId])
  @@map("reservations")
}

model Product {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  imageUrl      String?
  stock         Int?     @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([businessId])
  @@map("products")
}

model Order {
  id            String   @id @default(cuid())
  businessId    String
  clientName    String
  clientPhone   String
  total         Decimal  @db.Decimal(12, 2)
  status        String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@index([businessId])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  price         Decimal  @db.Decimal(12, 2)

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}